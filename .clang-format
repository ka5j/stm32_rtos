BasedOnStyle: GNU
IndentWidth: 2
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Allman        # brace on its own line — matches HAL/CMSIS style
SpaceBeforeParens: ControlStatements
PointerAlignment: Right           # int *p — matches typical embedded C
AlignConsecutiveAssignments: false
IndentCaseLabels: true