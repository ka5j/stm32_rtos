# Build output
build/
tests/build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.lst
*.su

# Doxygen output - generated by `make docs`, published to GitHub Pages by
# .github/workflows/pages.yml on every push to main. Never commit this -
# it's rebuilt fresh in CI each time, not tracked history.
docs/html/

# OpenOCD / debug
*.log
gdb.txt

# Editor / IDE
# .vscode/settings.json is tracked (format-on-save wired to .clang-format) -
# everything else under .vscode/ (launch.json, machine-specific paths, etc.)
# stays ignored.
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# clangd / language server (if you set one up for register autocomplete)
.cache/
compile_commands.json

# macOS
.DS_Store

