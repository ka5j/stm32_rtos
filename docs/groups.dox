/*
 * Declares the Topics hierarchy: one group per layer, one subgroup per
 * peripheral. A plain comment, not an @file block: this file has no code,
 * and a file page for it would link to a source page Doxygen never writes.
 *
 * Source files join a group with `@addtogroup <id>` / `@{` ... `@}` around
 * their definitions. Groups follow the layers in docs/ARCHITECTURE.md and
 * are declared here only once their layer has code. The ids reserved for
 * layers that do not exist yet are `peripheral_api` (api/), `rtos_layer`
 * with `rtos_kernel` and `rtos_api` (rtos/), and `application_layer` (app/).
 */

/**
 * @defgroup register_layer Register Layer
 * @brief Register structs and bit definitions mapped to fixed addresses,
 *        derived from the reference manuals without HAL or CMSIS.
 */

/**
 * @defgroup core_peripherals Cortex-M4 Core Peripherals
 * @ingroup register_layer
 * @brief Armv7-M system peripherals, from PM0214.
 */

/** @defgroup mpu_registers MPU
 *  @ingroup core_peripherals
 *  @brief Memory Protection Unit. */

/** @defgroup nvic_registers NVIC
 *  @ingroup core_peripherals
 *  @brief Nested Vectored Interrupt Controller and the IRQ numbers. */

/** @defgroup scb_registers SCB
 *  @ingroup core_peripherals
 *  @brief System Control Block. */

/** @defgroup fpu_registers FPU
 *  @ingroup core_peripherals
 *  @brief FPU context control (FPCCR, FPCAR, FPDSCR). */

/** @defgroup systick_registers SysTick
 *  @ingroup core_peripherals
 *  @brief SysTick timer. */

/**
 * @defgroup device_peripherals STM32F446 Peripherals
 * @ingroup register_layer
 * @brief STM32F446 peripherals, from RM0390.
 */

/** @defgroup exti_registers EXTI
 *  @ingroup device_peripherals
 *  @brief External interrupt/event controller. */

/** @defgroup flash_registers Flash Interface
 *  @ingroup device_peripherals
 *  @brief Flash access control (latency, prefetch, caches). */

/** @defgroup gpio_registers GPIO
 *  @ingroup device_peripherals
 *  @brief General-purpose I/O ports A to H. */

/** @defgroup iwdg_registers IWDG
 *  @ingroup device_peripherals
 *  @brief Independent watchdog. */

/** @defgroup pwr_registers PWR
 *  @ingroup device_peripherals
 *  @brief Power control: voltage scaling and over-drive. */

/** @defgroup rcc_registers RCC
 *  @ingroup device_peripherals
 *  @brief Reset and clock control. */

/** @defgroup syscfg_registers SYSCFG
 *  @ingroup device_peripherals
 *  @brief System configuration: EXTI routing and I/O compensation. */

/** @defgroup uart_registers USART/UART
 *  @ingroup device_peripherals
 *  @brief USART1-3/6 and UART4-5. */

/** @defgroup wwdg_registers WWDG
 *  @ingroup device_peripherals
 *  @brief Window watchdog. */

/**
 * @defgroup driver_layer Drivers
 * @brief Register-level drivers. Each takes its register block as a
 *        parameter and returns a ::DriverStatus_e where it can fail.
 */

/** @defgroup gpio_driver GPIO
 *  @ingroup driver_layer
 *  @brief Pin configuration and digital I/O. */

/** @defgroup rcc_driver RCC
 *  @ingroup driver_layer
 *  @brief Peripheral clock gating, oscillators, PLL and SYSCLK switch. */

/** @defgroup flash_driver Flash
 *  @ingroup driver_layer
 *  @brief Flash wait states, prefetch and caches. */

/** @defgroup pwr_driver PWR
 *  @ingroup driver_layer
 *  @brief Regulator voltage scaling and over-drive. */

/** @defgroup uart_driver UART
 *  @ingroup driver_layer
 *  @brief Blocking asynchronous USART/UART transfer. */

/** @defgroup nvic_driver NVIC
 *  @ingroup driver_layer
 *  @brief Interrupt enable, pending and priority control. */

/** @defgroup systick_driver SysTick
 *  @ingroup driver_layer
 *  @brief The system tick timer. */

/**
 * @defgroup board_support Board Support Package
 * @brief NUCLEO-F446RE configuration built on the drivers: today the
 *        180 MHz clock bring-up.
 */
