# Generate the sidebar tree-view navigation panel.
GENERATE_TREEVIEW      = YES

# Show a right-hand outline panel of the current page's own headings.
PAGE_OUTLINE_PANEL     = YES

# Full-height sidebar (ReadTheDocs-style) instead of a partial one.
