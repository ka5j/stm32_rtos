LATEX_EMOJI_DIRECTORY  =

#---------------------------------------------------------------------------
# Configuration options related to the RTF output
#---------------------------------------------------------------------------

# RTF (Word-compatible) output. Not generated.
GENERATE_RTF           = NO
RTF_OUTPUT             = rtf
COMPACT_RTF            = NO
RTF_HYPERLINKS         = NO
RTF_STYLESHEET_FILE    =
RTF_EXTENSIONS_FILE    =
RTF_EXTRA_FILES        =

#---------------------------------------------------------------------------
# Configuration options related to the man page output
#---------------------------------------------------------------------------

# Unix man-page output. Not generated.
GENERATE_MAN           = NO
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MAN_SUBDIR             =
MAN_LINKS              = NO

#---------------------------------------------------------------------------
# Configuration options related to the XML output
#---------------------------------------------------------------------------

# Machine-readable XML dump of the parsed structure. Not generated - no
# tool in this project's pipeline consumes it.
GENERATE_XML           = NO
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
XML_NS_MEMB_FILE_SCOPE = NO

#---------------------------------------------------------------------------
# Configuration options related to the DOCBOOK output
#---------------------------------------------------------------------------

# DocBook output. Not generated.
GENERATE_DOCBOOK       = NO
DOCBOOK_OUTPUT         = docbook

#---------------------------------------------------------------------------
# Configuration options for the AutoGen Definitions output
#---------------------------------------------------------------------------

# AutoGen Definitions dump (Doxygen's own experimental/incomplete
# format). Not generated.
GENERATE_AUTOGEN_DEF   = NO

#---------------------------------------------------------------------------
# Configuration options related to Sqlite3 output
#---------------------------------------------------------------------------

# Sqlite3 database dump of parsed symbols. Not generated.
GENERATE_SQLITE3       = NO
SQLITE3_OUTPUT         = sqlite3
SQLITE3_RECREATE_DB    = YES

#---------------------------------------------------------------------------
# Configuration options related to the Perl module output
#---------------------------------------------------------------------------

# Perl-module dump of parsed symbols. Not generated.
GENERATE_PERLMOD       = NO
PERLMOD_LATEX          = NO
PERLMOD_PRETTY         = YES
PERLMOD_MAKEVAR_PREFIX =

#---------------------------------------------------------------------------
# Configuration options related to the preprocessor
#---------------------------------------------------------------------------

# Evaluate #ifdef/#include preprocessor directives while parsing (needed
# for header guards and conditional code to resolve correctly).
ENABLE_PREPROCESSING   = YES

# Expand macro *uses* to their raw definition in the browsable source.
# Left off: this would replace readable names like DRIVER_MUST_CHECK with
# the raw __attribute__((warn_unused_result)) wherever used, hurting
# readability rather than helping it.
MACRO_EXPANSION        = NO

# Limit expansion to PREDEFINED/EXPAND_AS_DEFINED only. Irrelevant with
# MACRO_EXPANSION off.
EXPAND_ONLY_PREDEF     = NO

# Search INCLUDE_PATH for a #include target during preprocessing.
SEARCH_INCLUDES        = YES

# Extra directories preprocessed but not treated as INPUT. None needed -
# every header this project includes already lives under INPUT.
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS  =

# Macros predefined before preprocessing (like gcc's -D). None needed.
PREDEFINED             =

# Macros to expand when EXPAND_ONLY_PREDEF is on. Irrelevant with it off.
EXPAND_AS_DEFINED      =

# Strip references to bare, all-caps, semicolon-less function-like macros
# (boilerplate patterns that would otherwise confuse the parser).
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Configuration options related to external references
#---------------------------------------------------------------------------

# Link to symbols documented in another project's Doxygen tag file. None
# used - this project has no external Doxygen-documented dependency.
TAGFILES               =

# Generate this project's own tag file, for another project to link
# against. None needed - nothing currently links against this one.
GENERATE_TAGFILE       =

# List every external tag-file symbol in this project's own indices, not
# just ones actually referenced. Irrelevant with no TAGFILES.
ALLEXTERNALS           = NO

# List groups/pages from external tag files in this project's own Topics/
# related-pages indices. Irrelevant with no TAGFILES.
EXTERNAL_GROUPS        = YES
EXTERNAL_PAGES         = YES

#---------------------------------------------------------------------------
# Configuration options related to diagram generator tools
#---------------------------------------------------------------------------

# Hide an inheritance/collaboration edge whose target is undocumented or
# not a class/struct.
HIDE_UNDOC_RELATIONS   = YES

# Enable Graphviz `dot`-generated diagrams. The rest of this section has
# no effect without it.
HAVE_DOT               = YES

# Parallelism/batching for dot invocations. Defaults are fine at this
# project's size.
DOT_NUM_THREADS        = 0
DOT_BATCH_SIZE         = 50

# Font/edge/node styling applied to every generated graph.
DOT_COMMON_ATTR        = "fontname=Helvetica,fontsize=10"
DOT_EDGE_ATTR          = "labelfontname=Helvetica,labelfontsize=10"
DOT_NODE_ATTR          = "shape=box,height=0.2,width=0.4"

# Custom font search path for the above. Not needed - Helvetica resolves
# from the standard system font path.
DOT_FONTPATH           =

# Inheritance graph per documented struct/class. Overridden to NO: every
# documented struct here is a flat register block (uint32_t/uint8_t
# members only - none contains another documented struct as a field), so
# there is no inheritance to show and this would render an empty box per
# struct.
CLASS_GRAPH            = NO

# Containment/usage graph per documented struct/class. Overridden to NO
# for the same reason as CLASS_GRAPH above - no struct here contains
# another documented struct as a member.
COLLABORATION_GRAPH    = NO

# Dependency graph per Topics group (register_layer -> core_peripherals ->
# nvic_registers, etc.), generated straight from groups.dox's real
# \ingroup structure.
GROUP_GRAPHS           = YES

# Render graphs in UML notation instead of Doxygen's own box style. Not
# needed - this project's structs have no inheritance for UML notation to
# add value over the plain style.
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 10
UML_MAX_EDGE_LABELS    = 10
DOT_UML_DETAILS        = NO

# Max characters per line in a graph node label before wrapping.
DOT_WRAP_THRESHOLD     = 17

# Show relations between C++ templates and their instantiations. Not
# applicable - no C++ templates exist.
TEMPLATE_RELATIONS     = NO

# Per-file graph of #include dependencies, in both directions. Generated
# from the real #include graph, so a layering-rule violation (see
# CONTRIBUTING.md's layering rule) becomes visually obvious the moment it
# happens.
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Per-function call/caller graph. Overridden to NO: almost nothing calls
# anything yet above drivers/src/gpio.c (api/, bsp/, rtos/ are still
# empty - see README.md's Status section), so every function's graph
# today would be a single node with no edges. Revisit once api/ exists
# and there's a real call chain worth drawing.
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# Graphical (rather than textual) class-inheritance hierarchy page.
# Overridden to NO: there is no C++ inheritance to show; GROUP_GRAPHS and
# DIRECTORY_GRAPH already give this project's real hierarchy (the
# architectural layers) a visual form.
GRAPHICAL_HIERARCHY    = NO

# Per-directory graph of #include dependencies - an auto-generated,
# always-accurate version of docs/ARCHITECTURE.md's hand-drawn layer
# diagram, since it can't silently drift from what the code actually
# does.
DIRECTORY_GRAPH        = YES

# Child-directory levels shown in the directory graph. Raised from the
# default 1 to 2: rtos/ has two real, architecturally distinct
# subdirectories (rtos/kernel/, rtos/api/) that depth 1 would collapse
# into one generic "rtos" node.
DIR_GRAPH_MAX_DEPTH    = 2

# Image format for generated graphs. svg instead of the default png:
# crisp at any zoom level instead of a fixed-resolution bitmap. Pairs
# with INTERACTIVE_SVG below.
DOT_IMAGE_FORMAT       = svg

# Let generated SVG graphs be panned/zoomed in the browser. Enabled -
# useful once a directory/include graph has more than a couple of nodes.
INTERACTIVE_SVG        = YES

# Custom search path for the `dot` binary. Not needed - it's on PATH.
DOT_PATH               =

# Directories of hand-written .dot files to include via \dotfile. None -
# every diagram here is auto-generated, not hand-drawn.
DOTFILE_DIRS           =

# Dia-diagram support (\diafile). Not used.
DIA_PATH               =
DIAFILE_DIRS           =

# PlantUML support (\startuml). Not used.
PLANTUML_JAR_PATH      =
PLANTUML_CFG_FILE      =
PLANTUML_INCLUDE_PATH  =
PLANTUMLFILE_DIRS      =

# Mermaid diagram support (\mermaid). Not used - Graphviz/dot above
# already covers this project's diagramming needs.
MERMAID_PATH           =
MERMAID_CONFIG_FILE    =
MERMAID_RENDER_MODE    = AUTO
MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs
MERMAIDFILE_DIRS       =

# Truncate a graph beyond this many nodes (shown as a red box) rather
# than let it grow unbounded. Default is generous enough for this
# project's size.
DOT_GRAPH_MAX_NODES    = 50

# Max edge-hops from the root node shown in a graph. 0 = unrestricted;
# fine at this project's size.
MAX_DOT_GRAPH_DEPTH    = 0

# Generate the legend page explaining graph box/arrow meanings.
GENERATE_LEGEND        = YES

# Delete intermediate dot/msc files after rendering, keeping only the
# final images.
DOT_CLEANUP            = YES

# Message-sequence-chart support (\msc). Not used.
MSCGEN_TOOL            =
MSCFILE_DIRS           =
