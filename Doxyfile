# Doxyfile 1.18.0
#
# Settings for Doxygen (www.doxygen.org). `##` starts a comment placed in
# front of the following tag; `#` alone is ignored. Format: TAG = value,
# or TAG += value to append. Run `doxygen -x Doxyfile` to diff this
# against the current version's full template defaults.

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

# Character encoding for this file and all parsed source comments.
DOXYFILE_ENCODING      = UTF-8

# Project name shown in page titles and headers.
PROJECT_NAME           = "STM32 RTOS"

# Version/revision string. Bumped only on a develop->main release PR - see
# docs/VERSIONING.md.
PROJECT_NUMBER         = 0.1.3

# One-line description shown at the top of every page.
PROJECT_BRIEF          = "Bare-metal preemptive RTOS for STM32F446RE"

# Logo image (max 55x200px), copied into the output. None set.
PROJECT_LOGO           =

# Browser-tab icon. None set.
PROJECT_ICON           =

# Where generated output is written, relative to this file.
OUTPUT_DIRECTORY       = docs

# Spreads output over up to 4096 subdirectories - only useful for huge
# projects where one flat directory would hurt filesystem performance.
CREATE_SUBDIRS         = NO

# Subdirectory fan-out depth when CREATE_SUBDIRS=YES.
CREATE_SUBDIRS_LEVEL   = 8

# Allow non-ASCII characters in generated file names.
ALLOW_UNICODE_NAMES    = NO

# Language for Doxygen's own generated text (page titles, labels, etc).
OUTPUT_LANGUAGE        = English

# Show each member's brief description inline in file/class listings.
BRIEF_MEMBER_DESC      = YES

# Repeat the brief description at the top of the detailed section too.
REPEAT_BRIEF           = YES

# Leading words/phrases stripped from an auto-derived brief description
# before it's used as-is (Doxygen's own default list).
ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# Generate a detailed section even when only a brief description exists.
ALWAYS_DETAILED_SEC    = NO

# Show inherited members as if they belonged to the inheriting class.
INLINE_INHERITED_MEMB  = NO

# Show full relative paths in file listings/headers instead of just the
# shortest unique name.
FULL_PATH_NAMES        = YES

# Path prefix to strip when FULL_PATH_NAMES=YES. Blank = strip nothing
# (paths are already repo-root-relative since Doxygen runs from there).
STRIP_FROM_PATH        =

# Path prefix to strip from "#include to use this" hints. Blank = full
# header name only.
STRIP_FROM_INC_PATH    =

# Generate shorter, less-readable file names (only useful for legacy
# filesystems with name-length limits).
SHORT_NAMES            = NO

# Treat the first sentence of a Javadoc-style (/** */) comment as the
# @brief, without requiring an explicit @brief tag.
JAVADOC_AUTOBRIEF      = YES

# Treat a /*************** banner line as a Javadoc-style comment opener.
JAVADOC_BANNER         = NO

# Same auto-brief behavior as JAVADOC_AUTOBRIEF, for Qt-style comments.
QT_AUTOBRIEF           = NO

# Treat a multi-line /// or //! block as the brief description (legacy
# behavior) instead of the detailed one.
MULTILINE_CPP_IS_BRIEF = NO

# Render Python docstrings as Doxygen-processed text rather than
# preformatted. Not applicable - this project has no Python sources.
PYTHON_DOCSTRING       = YES

# An undocumented override inherits its base's documentation.
INHERIT_DOCS           = YES

# Give every member its own page instead of listing it within its
# file/class/namespace page.
SEPARATE_MEMBER_PAGES  = NO

# Spaces per tab when rendering code fragments.
TAB_SIZE               = 4

# Custom Doxygen-command aliases. None defined - no repeated pattern here
# has needed one yet.
ALIASES                =

# Tailor output for C: omits C++-only listings (all-members page, etc.)
# and changes some terminology. This project is pure C.
OPTIMIZE_OUTPUT_FOR_C  = YES

# Tailor output for Java/Python. Not applicable.
OPTIMIZE_OUTPUT_JAVA   = NO

# Tailor output for Fortran. Not applicable.
OPTIMIZE_FOR_FORTRAN   = NO

# Tailor output for VHDL. Not applicable.
OPTIMIZE_OUTPUT_VHDL   = NO

# Tailor output for Slice. Not applicable.
OPTIMIZE_OUTPUT_SLICE  = NO

# Override which parser handles a given file extension. Not needed - only
# standard .c/.h/.S/.md/.dox are used here.
EXTENSION_MAPPING      =

# Pre-process comments as Markdown before Doxygen's own markup.
MARKDOWN_SUPPORT       = YES

# Resolve Markdown/Doxygen markup ambiguities (backtick quoting) in
# Markdown's favor rather than Doxygen's native style.
MARKDOWN_STRICT        = YES

# Auto-include Markdown headings up to this depth in each page's table of
# contents.
TOC_INCLUDE_HEADINGS   = 6

# Heading-anchor naming scheme for Markdown headings.
MARKDOWN_ID_STYLE      = DOXYGEN

# Auto-link words in text that match a documented symbol's name.
AUTOLINK_SUPPORT       = YES

# Words to exclude from AUTOLINK_SUPPORT. None needed yet.
AUTOLINK_IGNORE_WORDS  =

# Recognize STL container types (std::string, etc.) without needing their
# headers as input. Not applicable - no C++ STL usage.
BUILTIN_STL_SUPPORT    = NO

# Parse Microsoft C++/CLI extensions. Not applicable.
CPP_CLI_SUPPORT        = NO

# Parse sip sources. Not applicable.
SIP_SUPPORT            = NO

# Render Microsoft IDL propget/propput pairs as a single property. Not
# applicable - this project has no IDL.
IDL_PROPERTY_SUPPORT   = YES

# Let one documented member in a \addtogroup block stand in for the
# whole group's documentation.
DISTRIBUTE_GROUP_DOC   = NO

# Auto-include a class's nested compounds in whatever group the class
# joins.
GROUP_NESTED_COMPOUNDS = NO

# Allow member groups of the same kind (e.g. all public functions) to
# nest as a subgroup under that kind's section.
SUBGROUPING            = YES

# Show grouped classes/structs inline within their group's page instead
# of as separate pages.
INLINE_GROUPED_CLASSES = NO

# Show simple structs (public data only) inline in their enclosing
# scope's documentation instead of on their own page.
INLINE_SIMPLE_STRUCTS  = NO

# For `typedef struct Foo_t {...} Foo_t;`, document it as struct `Foo_t`
# rather than as a typedef member. Matches this project's naming
# convention (CONTRIBUTING.md), but every register struct already
# documents cleanly either way with the tag name equal to the typedef.
TYPEDEF_HIDES_STRUCT   = NO

# Symbol-resolution cache size, as 2^(16+N). 0 = 65536 entries, plenty for
# this project's size.
LOOKUP_CACHE_SIZE      = 0

# Threads used for input processing. 1 effectively disables parallelism;
# not worth tuning at this project's size.
NUM_PROC_THREADS       = 1

# Stamp each generated page with its build date/time. Left off: this site
# represents "the last tagged release" (docs/VERSIONING.md), and a
# same-content rebuild showing a new date would misleadingly suggest
# fresher content than actually shipped.
TIMESTAMP              = NO

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

# Document every entity even with zero doc comments, and stop warning
# about undocumented members. Left off deliberately: CONTRIBUTING.md's
# doc-coverage gate (enforced again by CI's @file-block check) depends on
# undocumented members actually producing a warning.
EXTRACT_ALL            = NO

# Include private class members. Not applicable - C has no private/public
# class members, but left at its default rather than fighting it.
EXTRACT_PRIVATE        = YES

# Include documented private virtual methods. Not applicable (no C++).
EXTRACT_PRIV_VIRTUAL   = NO

# Include package/internal-scope members. Not applicable (no C++/Java).
EXTRACT_PACKAGE        = NO

# Include static file-scope members (relevant once a driver .c file
# defines static helpers).
EXTRACT_STATIC         = YES

# Include classes/structs defined locally inside a .c file, not just ones
# declared in headers.
EXTRACT_LOCAL_CLASSES  = YES

# Objective-C-only option. Not applicable.
EXTRACT_LOCAL_METHODS  = NO

# Extract anonymous-namespace members. Not applicable (no C++ namespaces).
EXTRACT_ANON_NSPACES   = NO

# Recover an unnamed parameter's name from its definition when the
# declaration omitted it.
RESOLVE_UNNAMED_PARAMS = YES

# Hide undocumented members from documented files/classes instead of
# listing them with no doc section.
HIDE_UNDOC_MEMBERS     = NO

# Hide undocumented classes from the class hierarchy/listings.
HIDE_UNDOC_CLASSES     = NO

# Hide undocumented namespaces. Not applicable (no C++ namespaces).
HIDE_UNDOC_NAMESPACES  = YES

# Hide C++ friend declarations. Not applicable.
HIDE_FRIEND_COMPOUNDS  = NO

# Hide documentation blocks written inside a function body instead of
# appending them to that function's detailed docs.
HIDE_IN_BODY_DOCS      = NO

# Include text after an \internal command. Off - nothing in this
# codebase is marked internal-only.
INTERNAL_DOCS          = NO

# Whether symbol name matching treats case as significant, to match the
# underlying filesystem's own case sensitivity. SYSTEM auto-detects.
CASE_SENSE_NAMES       = SYSTEM

# Hide each member's enclosing class/namespace scope in its listing.
HIDE_SCOPE_NAMES       = NO

# Hide the "- Class Reference" style suffix Doxygen appends to compound
# page titles.
HIDE_COMPOUND_REFERENCE= NO

# Show which header to #include to use a given documented entity.
SHOW_HEADERFILE        = YES

# List a file's own #include'd files in its documentation.
SHOW_INCLUDE_FILES     = YES

# Add an explicit #include hint under each grouped member too, not just
# once per file.
SHOW_GROUPED_MEMB_INC  = NO

# Render #include paths in a file's docs with double quotes instead of
# angle brackets.
FORCE_LOCAL_INCLUDES   = NO

# Tag inline functions/members as [inline] in their documentation.
INLINE_INFO            = YES

# Sort each file/class's *detailed* member documentation. Set to NO
# (overriding the default YES): this project's structs are memory-mapped
# register blocks where declaration order *is* the real hardware byte
# offset order (RM0390/PM0214) - alphabetical sorting was scrambling the
# detailed field docs (AFRH, AFRL, BSRR, IDR...) out of sync with the
# correctly-ordered summary table directly above it on the same page.
SORT_MEMBER_DOCS       = NO

# Sort *brief* descriptions/summary listings alphabetically. Left off:
# for the same reason as above, declaration order already reflects the
# intentional bit-position/register-offset grouping (see e.g. each
# header's "--- FOO_BAR bit definitions ---" comment blocks).
SORT_BRIEF_DOCS        = NO

# List constructors/destructors first regardless of sort order. Not
# applicable (no C++ classes).
SORT_MEMBERS_CTORS_1ST = NO

# Sort the Topics/group hierarchy alphabetically. Left off: groups.dox
# declares a deliberate architectural order (register layer -> drivers ->
# api -> bsp -> rtos -> app, matching docs/ARCHITECTURE.md) that
# alphabetical order would scramble.
SORT_GROUP_NAMES       = NO

# Sort the class list by fully-qualified (namespaced) name. Not
# applicable (no C++ namespaces).
SORT_BY_SCOPE_NAME     = NO

# Reject a prototype/implementation match unless every parameter type
# resolves exactly, instead of falling back to a simple string match.
STRICT_PROTO_MATCHING  = NO

# Generate the \todo list page. Unused today (no \todo comments exist)
# but harmless to leave on.
GENERATE_TODOLIST      = YES

# Generate the \test list page. Unused today, harmless to leave on.
GENERATE_TESTLIST      = YES

# Generate the \bug list page. Unused today, harmless to leave on.
GENERATE_BUGLIST       = YES

# Generate the \deprecated list page. Unused today, harmless to leave on.
GENERATE_DEPRECATEDLIST= YES

# Generate a requirements-traceability page from \requirement comments.
# Unused today - this project has no formal requirements-tracing
# convention - but harmless to leave on.
GENERATE_REQUIREMENTS  = YES

# Show \satisfies/\verifies traceability info on the requirements page,
# when GENERATE_REQUIREMENTS content exists.
REQ_TRACEABILITY_INFO  = YES

# Enable \if/\cond conditional documentation sections by label. None
# defined - no conditional doc sections exist in this codebase.
ENABLED_SECTIONS       =

# Max lines of a variable/macro initializer to show before hiding it.
# Every macro here is a one-line value, well under this.
MAX_INITIALIZER_LINES  = 30

# List the source file(s) a class/struct's documentation was generated
# from, at the bottom of its page.
SHOW_USED_FILES        = YES

# Generate the Files page/nav entry.
SHOW_FILES             = YES

# Generate the Namespaces page/nav entry. Doxygen already omits it when
# zero namespaces exist (this project has none, being pure C), so this
# has no visible effect either way.
SHOW_NAMESPACES        = YES

# External command to query a file's version (e.g. from source control)
# for display. Not used - PROJECT_NUMBER already tracks the release.
FILE_VERSION_FILTER    =

# Custom page-layout XML file, overriding Doxygen's built-in layout.
# None - the built-in layout is used as-is.
LAYOUT_FILE            =

# BibTeX bibliography files for \cite. None used.
CITE_BIB_FILES         =

# Extra PATH entries for external tools (latex, gs). Not needed - no
# LaTeX output is generated.
EXTERNAL_TOOL_PATH     =

#---------------------------------------------------------------------------
# Configuration options related to warning and progress messages
#---------------------------------------------------------------------------

# Print Doxygen's own progress messages to stdout.
QUIET                  = NO

# Print warnings to stderr.
WARNINGS               = YES

# Warn about undocumented members. This is the doc-coverage gate
# CONTRIBUTING.md and CI rely on.
WARN_IF_UNDOCUMENTED   = YES

# Warn about doc errors: duplicate/nonexistent @param entries, malformed
# markup, etc.
WARN_IF_DOC_ERROR      = YES

# Warn about a documented function with incomplete @param coverage.
WARN_IF_INCOMPLETE_DOC = YES

# Warn about a documented function with zero @param/@return documentation
# (a stricter subset of WARN_IF_INCOMPLETE_DOC).
WARN_NO_PARAMDOC       = YES

# Warn about an enum value with no doc comment. Left off deliberately:
# large hardware-derived enums (IRQn_e's 97 interrupt lines, GpioPin_e's
# 16 pin numbers) are self-explanatory from their name and assigned
# value; requiring a comment on every single one would be doc bureaucracy
# with no real reader benefit.
WARN_IF_UNDOC_ENUM_VAL = NO

# Warn about problems in a custom LAYOUT_FILE. Not applicable - none set.
WARN_LAYOUT_FILE       = YES

# Fail the run on any warning. This is what makes `make docs` a real gate
# rather than an FYI - see CONTRIBUTING.md's documentation-coverage rule.
WARN_AS_ERROR          = YES

# Warning message format.
WARN_FORMAT            = "$file:$line: $text"
WARN_LINE_FORMAT       = "at line $line of file $file"

# Where to write warnings. Blank = stderr.
WARN_LOGFILE           =

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

# Directories/files Doxygen parses. Excludes tests/ deliberately - the
# test suite isn't part of the public reference this site documents.
INPUT                  = app bsp core device drivers rtos docs/groups.dox docs/mainpage.md

# Character encoding of the input files.
INPUT_ENCODING         = UTF-8

# Per-file-pattern encoding override. Not needed - everything is UTF-8.
INPUT_FILE_ENCODING    =

# File extensions Doxygen treats as source (Doxygen's own full default
# list, so an .md/.dox file anywhere in INPUT is still picked up).
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cxxm \
                         *.cpp \
                         *.cppm \
                         *.ccm \
                         *.c++ \
                         *.c++m \
                         *.java \
                         *.ii \
                         *.ixx \
                         *.ipp \
                         *.i++ \
                         *.inl \
                         *.idl \
                         *.ddl \
                         *.odl \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.l \
                         *.cs \
                         *.d \
                         *.php \
                         *.php4 \
                         *.php5 \
                         *.phtml \
                         *.inc \
                         *.m \
                         *.markdown \
                         *.md \
                         *.mm \
                         *.dox \
                         *.py \
                         *.pyw \
                         *.f90 \
                         *.f95 \
                         *.f03 \
                         *.f08 \
                         *.f18 \
                         *.f \
                         *.for \
                         *.vhd \
                         *.vhdl \
                         *.ucf \
                         *.qsf \
                         *.ice

# Recurse into subdirectories of each INPUT entry.
RECURSIVE              = YES

# Files/directories to exclude from INPUT. None needed.
EXCLUDE                =

# Exclude symlinked files/directories. Not applicable.
EXCLUDE_SYMLINKS       = NO

# Wildcard exclude patterns within INPUT directories. None needed.
EXCLUDE_PATTERNS       =

# Symbol names to exclude from output entirely. None needed.
EXCLUDE_SYMBOLS        =

# Directories searched for \include'd example code. None - no \include
# usage in this codebase.
EXAMPLE_PATH           =

# File patterns within EXAMPLE_PATH. Irrelevant with EXAMPLE_PATH unset.
EXAMPLE_PATTERNS       = *

# Recurse into EXAMPLE_PATH subdirectories. Irrelevant with EXAMPLE_PATH
# unset.
EXAMPLE_RECURSIVE      = NO

# Directories searched for \image files. None used.
IMAGE_PATH             =

# External filter program run over each input file before parsing. None -
# no source transformation is needed.
INPUT_FILTER           =

# Per-file-pattern filter override. None needed.
FILTER_PATTERNS        =

# Apply INPUT_FILTER to the browsable source view too, not just parsing.
# Irrelevant with INPUT_FILTER unset.
FILTER_SOURCE_FILES    = NO

# Per-file-pattern source-filter override. Irrelevant with
# FILTER_SOURCE_FILES off.
FILTER_SOURCE_PATTERNS =

# Markdown file whose content becomes the generated index.html landing
# page.
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# Use a subdirectory's README.md as that directory's page automatically.
IMPLICIT_DIR_DOCS      = YES

# Column at which fixed-format Fortran treats the rest of a line as
# comment. Not applicable - no Fortran sources.
FORTRAN_COMMENT_AFTER  = 72

#---------------------------------------------------------------------------
# Configuration options related to source browsing
#---------------------------------------------------------------------------

# Generate a browsable, syntax-highlighted copy of every source file,
# cross-referenced with its documentation. Enabled: for a project whose
# whole value is "the register header is the reference," letting a reader
# click a macro used in gpio.c and jump to its definition in gpio_reg.h
# is worth more here than for a typical class-heavy project.
SOURCE_BROWSER         = YES

# Inline each function's full body into its own documentation entry, on
# top of the separate browsable source view. Left off - would triple-
# expose the same code alongside SOURCE_BROWSER and VERBATIM_HEADERS
# below, which is redundant rather than helpful.
INLINE_SOURCES         = NO

# Strip Doxygen comment blocks from the browsable source (plain code
# comments remain) so doc content isn't shown twice.
STRIP_CODE_COMMENTS    = YES

# Under each documented entity, list every documented place that
# references it. Enabled with SOURCE_BROWSER above - e.g. GPIO_MODE_AF's
# page lists gpio.c and gpio.h. Real signal at this project's size.
REFERENCED_BY_RELATION = YES

# The reverse direction: under each function, what it references.
REFERENCES_RELATION    = YES

# Cross-reference hyperlinks point into the browsable source rather than
# back to plain documentation.
REFERENCES_LINK_SOURCE = YES

# Hovering a source cross-reference link shows a tooltip with the
# target's prototype/brief.
SOURCE_TOOLTIPS        = YES

# Use GNU Global's htags instead of Doxygen's built-in source browser.
# Not installed/used.
USE_HTAGS              = NO

# Include a verbatim copy of each documented header's full text on its
# page.
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Configuration options related to the alphabetical class index
#---------------------------------------------------------------------------

# Generate the alphabetical index of all documented structs/classes.
ALPHABETICAL_INDEX     = YES

# Prefixes to ignore when alphabetizing (e.g. a common "C" class prefix).
# None needed - this project's naming convention doesn't use one.
IGNORE_PREFIX          =

#---------------------------------------------------------------------------
# Configuration options related to the HTML output
#---------------------------------------------------------------------------

# Generate HTML output. This is the only output format this project
# publishes (see GENERATE_LATEX/_RTF/_MAN/_XML/_DOCBOOK below, all off).
GENERATE_HTML          = YES

# Subdirectory (under OUTPUT_DIRECTORY) the HTML site is written to.
HTML_OUTPUT            = html

# File extension for generated HTML pages.
HTML_FILE_EXTENSION    = .html

# Custom page header/footer template overrides. None - Doxygen's own
# generated header/footer is used as-is.
HTML_HEADER            =
HTML_FOOTER            =

# Full stylesheet replacement (discouraged in favor of
# HTML_EXTRA_STYLESHEET below). None set.
HTML_STYLESHEET        =

# Extra CSS applied after Doxygen's own stylesheet, for overrides without
# replacing it wholesale. None needed - HTML_COLORSTYLE_HUE/SAT/GAMMA
# below already give enough control over this site's look.
HTML_EXTRA_STYLESHEET  =

# Extra images/assets copied into the HTML output directory. None
# needed - PROJECT_LOGO is unset and every diagram is Doxygen-generated.
HTML_EXTRA_FILES       =

# TOGGLE instead of the default AUTO_LIGHT: gives visitors an explicit
# light/dark switch on the page, not just OS-preference-following.
HTML_COLORSTYLE        = TOGGLE

# Accent hue/saturation/gamma applied to Doxygen's built-in stylesheet.
# 220 = blue, a conventional and legible choice for a technical reference.
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

# Vertical, JavaScript-driven navigation menu instead of static page tabs.
HTML_DYNAMIC_MENUS     = YES

# Let long documentation sections collapse/expand after page load.
# Enabled: several register headers document 20-40+ macros in one file
# (e.g. scb_reg.h, rcc_reg.h) - collapsible sections make a long page
# easier to scan.
HTML_DYNAMIC_SECTIONS  = YES

# Let source-code blocks fold/unfold in the browsable source view.
HTML_CODE_FOLDING      = YES

# Show a copy-to-clipboard icon on code/text fragments.
HTML_COPY_CLIPBOARD    = YES

# Namespace browser-stored settings (theme choice, etc.) under a
# project-specific key instead of sharing them across every Doxygen site
# a visitor has viewed. Not needed at this project's scale.
HTML_PROJECT_COOKIE    =

# Preferred number of initially-expanded entries in the tree-structured
# indices.
HTML_INDEX_NUM_ENTRIES = 100

